<?xml version="1.0" encoding="utf-8"?>
<!-- Release manifest: no permissions (the app is offline), no debugging and no Android Auto Backup,
     so the vault file is never copied to a cloud backup. @VERSION@/@BUILD@ are filled in by build.sh. -->
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	package="io.github.keklick1337.multi2fa"
	android:versionCode="@BUILD@"
	android:versionName="@VERSION@">

	<application android:label="Multi2FA TOTP"
		android:debuggable="false"
		android:allowBackup="false">
		<activity android:name="org.golang.app.GoNativeActivity"
			android:label="Multi2FA TOTP"
			android:configChanges="orientation|keyboardHidden|uiMode|screenSize|screenLayout"
			android:exported="true"
			android:theme="@android:style/Theme">
			<meta-data android:name="android.app.lib_name" android:value="Multi2FA" />
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
		<receiver android:name="org.golang.app.FyneNotificationReceiver" android:exported="false" />
	</application>
</manifest>
